#include <windows.h>

1 RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/packaging/windows/impasto.manifest"

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/packaging/windows/impasto.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ozzy-apps\0"
            VALUE "FileDescription", "Impasto\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "impasto\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 ozzy-apps\0"
            VALUE "OriginalFilename", "impasto.exe\0"
            VALUE "ProductName", "Impasto\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
